PORT=4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=relayops-dev-secret-change-me
# Set in production; the server refuses to boot with the default secret when NODE_ENV=production.
# NODE_ENV=production
# SEED_DEMO=true  # include demo account + sample data when seeding a production database
# Postgres (optional — falls back to local SQLite file ./data/relayops.db)
# DATABASE_URL=postgres://relayops:relayops@localhost:5432/relayops
# Redis + BullMQ (optional — falls back to in-process background runner)
# REDIS_URL=redis://localhost:6379
# AI (optional — Gemini free tier recommended; OpenAI-compatible also supported; built-in heuristic fallback when unset)
# AI_PROVIDER=gemini
# GOOGLE_API_KEY=your-google-ai-studio-key
# AI_MODEL=gemini-3.8-flash
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
VITE_API_URL=http://localhost:4000
